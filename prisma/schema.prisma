generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COACH
  STUDENT
  PARENT
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AccessSource {
  ACADEMY_CODE
  PAID
  ADMIN_GRANT
}

enum TestAccessStatus {
  READY
  USED
  REVOKED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  passwordHash String?
  name         String
  role         Role
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  coachProfile CoachProfile?
  student      Student?
  parentProfile ParentProfile?
  contentUploads ContentUpload[] @relation("ContentUploadOwner")
  generatedContent GeneratedContent[] @relation("GeneratedContentCreator")
  auditLogs AuditLog[]
}

model CoachProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students  Student[]
  calendarConnections CalendarConnection[]
  coachingSessions CoachingSession[]
  cohorts Cohort[]
  coachTasks CoachTask[]
  preInterviewAssignments PreInterviewAssignment[]
  coachAccessClaims CoachAccessCode[]
  createdAt DateTime  @default(now())
}

model Student {
  id               String          @id @default(cuid())
  userId           String?         @unique
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  coachId          String?
  coach            CoachProfile?   @relation(fields: [coachId], references: [id], onDelete: SetNull)
  studentCode      String          @unique
  accessKeyHash    String
  accessKeyCiphertext String?
  accessKeyExpiresAt DateTime
  credentialsDeliveryStatus String @default("PENDING")
  credentialsEmailedAt DateTime?
  credentialEmailAttempts Int @default(0)
  fullName         String
  gradeLevel       String?
  goal             String?
  academicTrack    String?
  profile          Json?
  legacyExternalId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  plans            StudyPlan[]
  dailyLogs        DailyLog[]
  examResults      ExamResult[]
  assessments      Assessment[]
  testAccesses     TestAccess[]
  payments         Payment[]
  studyTechniques  StudyTechnique[]
  reports          StudentReport[]
  libraryItems     LibraryItem[]
  parentProfiles   ParentProfile[]
  targets          StudentTarget[]
  topicProgress    TopicProgress[]
  practiceLogs     PracticeLog[]
  weeklyReflections WeeklyReflection[]
  taskReschedules  TaskReschedule[]
  practiceQuizzes  PracticeQuiz[]
  quizAttempts     PracticeQuizAttempt[]
  coachAlerts      CoachAlert[]
  reviewQueue      ReviewQueueItem[]
  contentUploads   ContentUpload[]
  generatedContent GeneratedContent[]
  contentProgress ContentProgress[]
  techniquePreferences TechniquePreference[]
  techniqueSessions TechniquePracticeSession[]
  coachingSessions CoachingSession[]
  coachingActions CoachingAction[]
  taskSubmissions TaskSubmission[]
  coachBotMessages CoachBotMessage[]
  examAnalytics ExamAnalyticsRecord[]
  gamification StudentGamification?
  gameAttempts GameAttempt[]
  generatedGames GameContent[]
  badges BadgeAward[]
  cohortMemberships CohortMember[]
  forumPosts ForumPost[]
  progressShares ProgressShare[]
  xpLedger XpLedger[]
  coachTasks CoachTask[]
  preInterviewAttempts PreInterviewAttempt[]
  preInterviewAssignments PreInterviewAssignment[]
  coachAccessCodes CoachAccessCode[]
  wrongQuestions QuestionBankItem[] @relation("StudentWrongQuestions")
}

model CoachAccessCode {
  id               String        @id @default(cuid())
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  codeHash         String        @unique
  codeHint         String
  codeCiphertext   String
  active           Boolean       @default(true)
  expiresAt        DateTime
  usedAt           DateTime?
  claimedByCoachId String?
  claimedByCoach   CoachProfile? @relation(fields: [claimedByCoachId], references: [id], onDelete: SetNull)
  assessmentId     String?
  createdAt        DateTime      @default(now())

  @@index([studentId, active])
  @@index([claimedByCoachId, createdAt])
}

model StudyPlan {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  payload     Json
  active      Boolean  @default(true)
  legacyId    String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DailyLog {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  payload   Json
  legacyId  String?  @unique
  createdAt DateTime @default(now())
}

model ExamResult {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examType  String
  payload   Json
  legacyId  String?  @unique
  createdAt DateTime @default(now())
}

model AcademyCode {
  id                String   @id @default(cuid())
  codeHash          String   @unique
  codeHint          String
  assignedStudentId String?
  maxUses           Int      @default(1)
  useCount          Int      @default(0)
  active            Boolean  @default(true)
  expiresAt         DateTime?
  createdByUserId   String
  createdAt         DateTime @default(now())
  usedAt            DateTime?
  monthlyRecurring  Boolean  @default(false)
  codeCiphertext    String?

  @@index([assignedStudentId, monthlyRecurring, active])
}

model TestAccess {
  id            String           @id @default(cuid())
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  source        AccessSource
  status        TestAccessStatus @default(READY)
  academyCodeId String?
  paymentId     String?
  createdAt     DateTime         @default(now())
  usedAt        DateTime?

  @@index([studentId, status])
}

model Payment {
  id              String        @id @default(cuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  provider        String        @default("PAYTR")
  merchantOid     String        @unique
  amountKurus     Int
  status          PaymentStatus @default(PENDING)
  providerPayload Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Assessment {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  formVersion String
  answers     Json
  scores      Json
  report      Json
  completedAt DateTime @default(now())
  emailedAt   DateTime?
}

model TestQuestion {
  id          String   @id @default(cuid())
  formVersion String
  ageBand     String
  orderNo     Int
  dimension   String
  reverse     Boolean  @default(false)
  prompt      String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([formVersion, ageBand, orderNo])
  @@index([formVersion, ageBand, active])
}


model StudyTechnique {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
}

model StudentReport {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title            String
  summary          String?
  content          String
  createdByUserId  String?
  visibleToStudent Boolean  @default(true)
  visibleToParent  Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([studentId])
}

model LibraryItem {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title           String
  note            String?
  fileName        String?
  mimeType        String?
  fileSize        Int?
  fileData        Bytes?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([studentId])
}

model ParentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  accessCodeHash String
  codeHint       String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId])
}


model StudentTarget {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examLevel       String
  institutionName String
  departmentName  String?
  programCode     String?
  source          String
  sourceUrl       String?
  dataYear        Int?
  score           Float?
  ranking         Int?
  percentile      Float?
  benchmarkNets   Json?
  qualificationLevel      String?
  appointmentCount        Int?
  placedCount             Int?
  officialMinScore        Float?
  officialMaxScore        Float?
  officialEligibilityScore Float?
  officialScoreType       String?
  officialNets            Json?
  officialNetsStatus      String   @default("NOT_CHECKED")
  officialPeriod          String?
  active          Boolean  @default(true)
  syncedAt        DateTime?
  syncStatus      String   @default("PENDING")
  sourceSnapshot  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId, active])
}

model TopicProgress {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examType    String
  subject     String
  topic       String
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, examType, subject, topic])
  @@index([studentId, examType])
}

model PracticeLog {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examType  String
  subject   String
  topic     String?
  correct   Int
  wrong     Int
  blank     Int
  total     Int
  net       Float
  errorReason String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([studentId, date])
}

model QuestionBankItem {
  id                String   @id @default(cuid())
  examType          String
  subject           String
  topic             String
  prompt            String
  options           Json
  correctAnswer     String
  explanation       String?
  sourceKind        String   @default("ORIGINAL")
  ownerStudentId    String?
  ownerStudent      Student? @relation("StudentWrongQuestions", fields: [ownerStudentId], references: [id], onDelete: Cascade)
  imageMimeType     String?
  imageData         Bytes?
  classificationConfidence Float?
  classificationMethod String?
  originalStudentAnswer String?
  sourceYear        Int?
  officialSourceUrl String?
  active            Boolean  @default(true)
  reviewStatus      String   @default("APPROVED")
  reviewedAt        DateTime?
  reviewedByUserId  String?
  reviewNote        String?
  createdAt         DateTime @default(now())
  reviewQueue       ReviewQueueItem[]

  @@index([examType, subject, topic, active])
  @@index([ownerStudentId, createdAt])
}

model PracticeQuiz {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title           String
  examType        String
  subject         String
  topic           String?
  questionIds     Json
  createdByUserId String?
  createdAt       DateTime @default(now())
  attempts        PracticeQuizAttempt[]

  @@index([studentId, createdAt])
}

model PracticeQuizAttempt {
  id        String       @id @default(cuid())
  quizId    String
  quiz      PracticeQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId String
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers   Json
  correct   Int
  wrong     Int
  blank     Int
  net       Float
  createdAt DateTime     @default(now())
  reviewQueue ReviewQueueItem[]

  @@index([studentId, createdAt])
}


model CoachAlert {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind       String
  severity   String
  title      String
  message    String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([studentId, resolved])
}


model ReviewQueueItem {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId      String
  question        QuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sourceAttemptId String?
  sourceAttempt   PracticeQuizAttempt? @relation(fields: [sourceAttemptId], references: [id], onDelete: SetNull)
  stepIndex       Int      @default(0)
  dueAt           DateTime
  status          String   @default("DUE")
  lastCorrect     Boolean?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([studentId, questionId])
  @@index([studentId, dueAt])
}


model ContentUpload {
  id               String   @id @default(cuid())
  studentId        String?
  student          Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ownerUserId      String
  owner            User     @relation("ContentUploadOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  fileName         String
  mimeType         String
  fileSize         Int
  fileData         Bytes
  sha256           String
  extractedText    String?
  category         String   @default("AUTO")
  isQuestionSource Boolean  @default(false)
  status           String   @default("UPLOADED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  generated        GeneratedContent[]

  @@index([studentId, createdAt])
  @@index([ownerUserId, createdAt])
}

model GeneratedContent {
  id               String   @id @default(cuid())
  uploadId         String
  upload           ContentUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  studentId        String?
  student          Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdByUserId  String
  createdBy        User     @relation("GeneratedContentCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  type             String
  title            String
  payload          Json
  fingerprint      String   @unique
  status           String   @default("DRAFT")
  qualityScore     Float?
  visibleToStudent Boolean  @default(false)
  visibleToParent  Boolean  @default(false)
  createdAt        DateTime @default(now())
  revision         Int      @default(1)
  approvedAt       DateTime?
  approvedByUserId String?
  progress         ContentProgress[]
  updatedAt        DateTime @updatedAt

  @@index([studentId, status])
  @@index([uploadId, type])
}


model ContentProgress {
  id           String   @id @default(cuid())
  contentId    String
  content      GeneratedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  state        Json     @default("{}")
  score        Float?
  completed    Boolean  @default(false)
  completedAt  DateTime?
  lastOpenedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([contentId, studentId])
  @@index([studentId, updatedAt])
}


model TechniquePreference {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  techniqueKey String
  config       Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, techniqueKey])
}

model TechniquePracticeSession {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  techniqueKey    String
  title           String
  config          Json     @default("{}")
  result          Json     @default("{}")
  durationMinutes Int      @default(0)
  activeSeconds   Int      @default(0)
  clientSessionId String?
  interruptedReason String?
  completed       Boolean  @default(true)
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([studentId, createdAt])
  @@unique([studentId, clientSessionId])
}


model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
}


model CalendarConnection {
  id                     String   @id @default(cuid())
  coachId                String
  coach                  CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  provider               String
  accountEmail           String?
  calendarId             String?
  timeZone               String   @default("Europe/Istanbul")
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  expiresAt              DateTime?
  syncToken              String?
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([coachId, provider])
}

model CoachingSession {
  id                String   @id @default(cuid())
  coachId           String
  coach             CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title             String
  startsAt          DateTime
  endsAt            DateTime
  timeZone          String   @default("Europe/Istanbul")
  status            String   @default("SCHEDULED")
  calendarProvider  String?
  externalEventId   String?
  meetingProvider   String?
  meetingUrl        String?
  notes             String?
  createdByUserId   String?
  syncStatus        String   @default("LOCAL")
  prepSummary       Json?
  outcome           String?
  decisions         Json?
  nextStep          String?
  followUpAt        DateTime?
  completedAt       DateTime?
  actions           CoachingAction[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([coachId, startsAt])
  @@index([studentId, startsAt])
}

model CoachingAction {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId       String?
  session         CoachingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdByUserId String?
  title           String
  description     String?
  metricType      String   @default("COUNT")
  targetValue     Float    @default(1)
  currentValue    Float    @default(0)
  cadence         String   @default("WEEKLY")
  periodStart     DateTime
  periodEnd       DateTime
  status          String   @default("ACTIVE")
  subject         String?
  topic           String?
  taskDate        DateTime?
  planSource      String   @default("COACH")
  submission      TaskSubmission?
  rescheduleSource TaskReschedule? @relation("TaskRescheduleSource")
  rescheduleCreated TaskReschedule? @relation("TaskRescheduleCreated")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId, periodStart, periodEnd])
}

model CoachBotMessage {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role      String
  content   String
  intent    String?
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

model ExamAnalyticsRecord {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examType     String
  subject      String
  topic        String
  questionType String   @default("GENEL")
  correct      Int      @default(0)
  wrong        Int      @default(0)
  blank        Int      @default(0)
  avgSeconds   Float?
  examDate     DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([studentId, examDate])
}

model StudentGamification {
  id           String   @id @default(cuid())
  studentId    String   @unique
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  xp           Int      @default(0)
  level        Int      @default(1)
  streak       Int      @default(0)
  lastPlayedAt DateTime?
  updatedAt    DateTime @updatedAt
}

model GameContent {
  id               String   @id @default(cuid())
  gameType         String
  examType         String?
  subject          String
  topic            String
  title            String
  payload          Json
  difficulty       String   @default("ORTA")
  active           Boolean  @default(true)
  createdByUserId  String?
  studentId        String?
  student          Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  generationSource String   @default("MANUAL")
  generationKey    String?  @unique
  attempts         GameAttempt[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([subject, topic, active])
  @@index([studentId, active, createdAt])
}

model GameAttempt {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gameContentId   String
  gameContent     GameContent @relation(fields: [gameContentId], references: [id], onDelete: Cascade)
  score           Int
  maxScore        Int
  durationSeconds Int      @default(0)
  xpEarned        Int      @default(0)
  mistakes        Json?
  completedAt     DateTime @default(now())

  @@index([studentId, completedAt])
}

model BadgeAward {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeKey    String
  title       String
  description String?
  awardedAt   DateTime @default(now())

  @@unique([studentId, badgeKey])
}

model Cohort {
  id          String   @id @default(cuid())
  coachId     String
  coach       CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name        String
  description String?
  active      Boolean  @default(true)
  members     CohortMember[]
  posts       ForumPost[]
  createdAt   DateTime @default(now())
}

model CohortMember {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([cohortId, studentId])
}

model ForumPost {
  id           String   @id @default(cuid())
  cohortId     String
  cohort       Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  studentId    String?
  student      Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorUserId String?
  parentId     String?
  parent       ForumPost? @relation("ForumReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ForumPost[] @relation("ForumReplies")
  body         String
  createdAt    DateTime @default(now())

  @@index([cohortId, createdAt])
}

model ProgressShare {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdByUserId String?
  recipientLabel  String
  scope           Json     @default("{}")
  tokenHash       String   @unique
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([studentId, createdAt])
}


model XpLedger {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  source    String
  sourceId  String?
  xp        Int
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}


model CoachTask {
  id          String   @id @default(cuid())
  coachId     String
  coach       CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN")
  dueAt       DateTime?
  sourceType  String?
  sourceId    String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([coachId, status, dueAt])
  @@index([studentId, status])
}


model TaskSubmission {
  id             String   @id @default(cuid())
  actionId       String   @unique
  action         CoachingAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        String
  topic          String?
  totalQuestions Int
  correct        Int
  wrong          Int
  blank          Int
  net            Float
  accuracy       Float
  completionRate Float
  submittedAt    DateTime @default(now())
  late           Boolean  @default(false)
  alarmLevel     String   @default("NORMAL")
  evaluation     Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId, submittedAt])
}

model PreInterviewForm {
  id        String   @id @default(cuid())
  title     String
  version   String   @unique
  sourceUrl String?
  educationBand String @default("GENERAL")
  active    Boolean  @default(true)
  questions PreInterviewQuestion[]
  attempts  PreInterviewAttempt[]
  assignments PreInterviewAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PreInterviewQuestion {
  id           String   @id @default(cuid())
  formId       String
  form         PreInterviewForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  orderNo      Int
  dimension    String
  prompt       String
  responseType String   @default("LIKERT")
  options      Json?
  reverse      Boolean  @default(false)
  motivationKey String?
  required     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([formId, orderNo])
}

model PreInterviewAttempt {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  formId        String
  form          PreInterviewForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  academicTrack String
  answers       Json
  scores        Json
  report        Json
  assignmentId  String? @unique
  assignment    PreInterviewAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  reviewStatus  String   @default("PENDING")
  publishedAt   DateTime?
  completedAt   DateTime @default(now())

  @@index([studentId, completedAt])
}


model PreInterviewAssignment {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  formId           String
  form             PreInterviewForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  coachId          String
  coach            CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  status           String   @default("ASSIGNED")
  assignedAt       DateTime @default(now())
  completedAt      DateTime?
  approvedAt       DateTime?
  approvedByUserId String?
  revokedAt        DateTime?
  attempt          PreInterviewAttempt?

  @@index([studentId, status])
  @@index([coachId, status])
}


model WeeklyReflection {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weekStart        DateTime
  selfRating       Int
  bestThing        String?
  biggestChallenge String?
  repeatedDelay    String?
  nextWeekChange   String?
  systemSnapshot   Json     @default("{}")
  comparison       Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([studentId, weekStart])
}

model TaskReschedule {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourceActionId  String   @unique
  sourceAction    CoachingAction @relation("TaskRescheduleSource", fields: [sourceActionId], references: [id], onDelete: Cascade)
  createdActionId String?  @unique
  createdAction   CoachingAction? @relation("TaskRescheduleCreated", fields: [createdActionId], references: [id], onDelete: SetNull)
  createdActionIds Json     @default("[]")
  originalDate    DateTime
  newDate         DateTime
  movedTarget     Float
  reason          String   @default("AUTO_MISSED")
  createdAt       DateTime @default(now())

  @@index([studentId, createdAt])
}


model EmailSenderConfig {
  id                    String   @id
  email                 String
  appPasswordCiphertext String
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


model PaytrConfig {
  id                     String   @id
  merchantId             String
  merchantKeyCiphertext  String
  merchantSaltCiphertext String
  testMode               Boolean  @default(true)
  enabled                Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
